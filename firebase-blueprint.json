{
  "entities": {
    "StudioConfig": {
      "title": "StudioConfig",
      "description": "Shared real-time studio branding, colors, contact details, and pricing synchronized from the admin panel to all user apps.",
      "type": "object",
      "properties": {
        "studioName": {
          "type": "string",
          "description": "Display name of the tattoo studio.",
          "minLength": 2,
          "maxLength": 60
        },
        "whatsapp": {
          "type": "string",
          "description": "Studio WhatsApp digits with country code.",
          "pattern": "^[0-9]{10,15}$",
          "minLength": 10,
          "maxLength": 15
        },
        "instagram": {
          "type": "string",
          "description": "Instagram handle without @.",
          "pattern": "^[a-zA-Z0-9._]{1,40}$",
          "minLength": 1,
          "maxLength": 40
        },
        "publicCoupon": {
          "type": "string",
          "description": "Public referral coupon code.",
          "pattern": "^[A-Z0-9_-]{3,32}$",
          "minLength": 3,
          "maxLength": 32
        },
        "logoDataUrl": {
          "type": "string",
          "description": "Compressed profile logo data URL or empty string to use default bundled logo.",
          "maxLength": 350000
        },
        "promoBannerDataUrl": {
          "type": "string",
          "description": "Compressed monthly promotional banner image data URL or empty string when hidden from clients.",
          "maxLength": 420000
        },
        "promoBannerTitle": {
          "type": "string",
          "description": "Optional promotional banner headline shown beneath or above the banner.",
          "maxLength": 80
        },
        "promoBannerMonth": {
          "type": "string",
          "description": "Optional campaign month/label badge for the promotional banner.",
          "maxLength": 32
        },
        "apkDownloadUrl": {
          "type": "string",
          "description": "Optional HTTPS or /downloads/*.apk URL pointing to the signed Android APK file for direct download.",
          "maxLength": 500
        },
        "primaryColor": {
          "type": "string",
          "description": "Primary brand accent hex color.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7
        },
        "accentGoldColor": {
          "type": "string",
          "description": "Secondary highlight gold hex color.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7
        },
        "bgDarkColor": {
          "type": "string",
          "description": "Dark mode canvas background hex color.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7
        },
        "fullSleeveMin": {
          "type": "number",
          "description": "Minimum starting price in BRL for full limb closure."
        },
        "sizeTiers": {
          "type": "array",
          "description": "Ordered list of 6 size-tier min/max price ranges used by the quote calculator."
        },
        "priceItems": {
          "type": "array",
          "description": "Ordered list of 9 price-table min/max ranges displayed in the Prices tab."
        },
        "configVersion": {
          "type": "integer",
          "description": "Monotonic remote configuration version number."
        },
        "updatedByUid": {
          "type": "string",
          "description": "Firebase UID of the verified admin who published the update.",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the configuration was last updated."
        }
      },
      "required": [
        "studioName",
        "whatsapp",
        "instagram",
        "publicCoupon",
        "logoDataUrl",
        "promoBannerDataUrl",
        "promoBannerTitle",
        "promoBannerMonth",
        "apkDownloadUrl",
        "primaryColor",
        "accentGoldColor",
        "bgDarkColor",
        "fullSleeveMin",
        "sizeTiers",
        "priceItems",
        "configVersion",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Verified administrator allowlist record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address.",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Admin role.",
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "ScheduleSlot": {
      "title": "ScheduleSlot",
      "description": "Public non-PII slot lock representing a booked or studio-blocked date and time.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "description": "24h time HH:MM.",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "minLength": 5,
          "maxLength": 5
        },
        "status": {
          "type": "string",
          "enum": ["booked", "blocked"],
          "description": "Slot occupancy status.",
          "maxLength": 12
        },
        "serviceHint": {
          "type": "string",
          "description": "Generic non-PII service/status label.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["date", "time", "status", "serviceHint", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Private client appointment request containing contact details and tattoo preferences (readable only by verified admin).",
      "type": "object",
      "properties": {
        "slotId": {
          "type": "string",
          "description": "Canonical YYYY-MM-DD_HHMM slot identifier.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$",
          "minLength": 15,
          "maxLength": 15
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "minLength": 5,
          "maxLength": 5
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "clientWhatsapp": {
          "type": "string",
          "pattern": "^[0-9]{10,15}$",
          "minLength": 10,
          "maxLength": 15
        },
        "style": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "bodyZone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "size": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slotId",
        "date",
        "time",
        "clientName",
        "clientWhatsapp",
        "style",
        "bodyZone",
        "size",
        "notes",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": {
        "$ref": "#/entities/StudioConfig"
      },
      "description": "Stores the global studio configuration document (`studio`) synchronized to all client apps."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Admin privilege lookup collection."
    },
    "/schedule_slots/{slotId}": {
      "schema": {
        "$ref": "#/entities/ScheduleSlot"
      },
      "description": "Public non-PII slot availability locks preventing double bookings."
    },
    "/appointments/{appointmentId}": {
      "schema": {
        "$ref": "#/entities/Appointment"
      },
      "description": "Private client booking records readable and manageable strictly by the verified admin."
    }
  }
}
